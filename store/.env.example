DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# PayPal sandbox — see PAYPAL_SETUP.md at the repo root
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Only needed to exercise the webhook path; capture works without it.
PAYPAL_WEBHOOK_ID=

# Set to 1 to expose the "Simulate payment" checkout fallback, which places a
# real order without contacting PayPal. Intended as insurance for live demos.
# Ignored unless PAYPAL_API_BASE points at the sandbox. Leave blank otherwise —
# /api/demo/checkout 404s when this is unset.
DEMO_CHECKOUT_FALLBACK=
