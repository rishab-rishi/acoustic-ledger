DATABASE_URL=
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Bearer value for the `x-health-token` header on GET /api/health. Without a
# matching token the route returns only `{ ok }` — no hostname, region, env
# var names, or driver errors. Leave unset in an environment you don't trust
# with the detailed diagnostic; the route never falls open when it's unset.
HEALTH_TOKEN=

# Set to 1 to send the Content-Security-Policy as enforcing instead of
# Content-Security-Policy-Report-Only. Do this only after watching a full
# add-to-cart -> PayPal sandbox checkout -> confirmation flow in a real
# browser's console with zero CSP violations — see SECURITY.md.
CSP_ENFORCE=

# PayPal sandbox — see PAYPAL_SETUP.md at the repo root
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
# Only needed to exercise the webhook path; capture works without it.
PAYPAL_WEBHOOK_ID=

# Set to 1 to expose the "Simulate payment" checkout fallback, which places a
# real order without contacting PayPal. Intended as insurance for live demos.
# Ignored unless PAYPAL_API_BASE points at the sandbox. Leave blank otherwise —
# /api/demo/checkout 404s when this is unset.
DEMO_CHECKOUT_FALLBACK=
